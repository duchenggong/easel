# ============================================================
# Easel 环境变量 — 标准 Anthropic API key
# 复制为 .env 并填入真实值：cp .env.example .env
# ============================================================

# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# 模型（OpenClaw provider/model 格式）
CLAUDE_MODEL=anthropic/claude-sonnet-4-6

# 可选：Anthropic-compatible 服务
# EASEL_LLM_API_KEY=REPLACE_ME
# EASEL_LLM_BASE_URL=https://your-provider.example/v1
# EASEL_LLM_API_KEY_HEADER=api-key
# EASEL_LLM_ANTHROPIC_VERSION=2023-06-01

# ============================================================
# 可选：公司 AI 网关（OpenAI 兼容，Bearer 鉴权）作为主模型
# 配置后运行 setup.sh 会自动注册 company-ai Provider
# ============================================================
# COMPANY_AI_BASE_URL=http://aicenter-test.youlu.com/v1
# COMPANY_AI_API_KEY=你的网关Key
# COMPANY_AI_MODEL=qwen3.7-max
# CLAUDE_MODEL 与上面对应（company-ai/<模型>）
# CLAUDE_MODEL=company-ai/qwen3.7-max

# AI 生图（OpenAI 兼容 /images/generations；公司网关或百炼兼容服务）
# IMG_BASE_URL=http://aicenter-test.youlu.com/v1
# IMG_MODEL=qwen-image-3.0-pro
# IMG_API_KEY=同公司网关Key

# OpenClaw gateway 端口
OPENCLAW_PORT=18789

# ============================================================
# 可选：媒体生成模型（也可在 Web「技能库」对应技能里填写）
# 只需配置实际使用的 provider；密钥留空不会启用。
# ============================================================

# 视频：dashscope / ark / kling / openai-compatible / xhs-maas / agnes
VIDEO_PROVIDER=
# AGNES_API_KEY=
# AGNES_MODEL=agnes-video-2.5-flash
# VIDEO_API_KEY=
# VIDEO_BASE_URL=
# VIDEO_MODEL=

# AI 音乐：dashscope / suno-compatible
MUSIC_PROVIDER=
# MUSIC_API_KEY=
# MUSIC_BASE_URL=
# MUSIC_MODEL=

# 云端 TTS：dashscope / minimax / fish-audio / openai-compatible / gemini
VOICE_PROVIDER=
# VOICE_API_KEY=
# VOICE_BASE_URL=
# VOICE_MODEL=
# GEMINI_API_KEY=
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# 多个媒体能力可复用同一份 DashScope key（需在百炼为该 Key 开通对应模型权限）
# DASHSCOPE_API_KEY=sk-你的百炼Key
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# 视频（wan2.5+ 自动走新版 video-generation 协议，分辨率 720P/1080P）
# DASHSCOPE_T2V_MODEL=wan2.7-t2v
# DASHSCOPE_I2V_MODEL=wan2.7-i2v
# DASHSCOPE_VIDEO_MODEL=wan2.7-t2v
# DASHSCOPE_VIDEO_RESOLUTION=720P
# 视频编辑与旧版协议模型
# DASHSCOPE_VIDEO_EDIT_MODEL=happyhorse-1.0-video-edit
# 音乐（邀测模型，需在百炼模型广场申请开通）
# DASHSCOPE_MUSIC_MODEL=fun-music-v1
# TTS（含克隆音色）
# DASHSCOPE_TTS_MODEL=qwen-audio-3.0-tts-flash
# VOICE_NARRATOR_VOICE_ID=longanhuan_v3.6
